{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@utils/*": ["./utils/*"],
      "@lib/*": ["./lib/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
