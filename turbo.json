{
  "$schema": "https://v2-9-9.turborepo.dev/schema.json",
  "globalDependencies": ["./apps/web/.env", "./packages/database/.env"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "DIRECT_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^db:generate"]
    },
    "lint": {},
    "start": {},
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
